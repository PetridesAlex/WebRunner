{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/cookies",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, s-maxage=0"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate, s-maxage=0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/web-development",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/web-development/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mobile-app-development",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/mobile-app-development/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ecommerce-development",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ecommerce-development/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/custom-software-development",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/custom-software-development/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/crm-development",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/crm-development/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/business-automation",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/business-automation/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/api-integrations",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/api-integrations/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/work/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/",
      "permanent": true
    }
  ]
}
